/*
 * OligoGym benchmark reproduction -- production Nextflow config.
 *
 * Every resource figure here traces to a Phase 2 measurement on this project's
 * own AWS Batch hardware; the justification is in the comment beside it and in
 * pipeline_notes.md.  Nothing is inherited from the paper.
 */

plugins {
    id 'nf-amazon'
}

manifest {
    name            = 'oligogym-bench'
    description     = 'Reproduction of the OligoGym benchmark (Roche), 9,190 published configs'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    /*
     * The image was built and GPU-verified in Phase 2 (torch 2.13.0+cu126,
     * Tesla T4, capability (7,5), sm_75 in arch_list) and carries the 1.2 GB
     * RNA-FM checkpoint baked in at
     * /opt/torch-hub/checkpoints/RNA-FM_pretrained.pth.
     *
     * A DIGEST PIN WAS THE FIRST CHOICE AND WAVE REJECTS IT.  Measured:
     * `...oligogym-bench@sha256:c1bb023c...` fails every task at submit with
     *   Wave invalid response [400]: "Container requests made using a SHA256 as
     *   tag does not support the 'containerConfig' attribute"
     * because Fusion v2 injects a containerConfig, and Wave refuses that
     * combination.  Fusion requires Wave, so the choice is digest-pin OR Fusion,
     * not both.  Fusion wins: it is what makes S3 staging work at this task
     * count.
     *
     * The reproducibility guarantee a digest pin would have given is recovered
     * two other ways, both stronger than a tag string:
     *   * `image_digest_expected` below is recorded into every output row, so
     *     each result states which build it claims to come from;
     *   * RNA-FM chunks assert the baked checkpoint's parameter count before
     *     fold 0 (preflight_rnafm), which verifies image *content* rather than
     *     its label.
     * Residual risk, stated plainly: if :latest is re-pushed mid-sweep, tasks
     * launched after that point run the new build while reporting the expected
     * digest.  Do not re-tag :latest while a sweep is in flight.
     */
    image                 = 'ghcr.io/stevenfroelichbmrn/oligogym-bench:latest'
    image_digest_expected = 'sha256:c1bb023c3c5f317e1b071b97af0e0d5608d571bbaf541172b689bab7333ab8a8'
}

process {
    container     = params.image
    cache         = 'lenient'   // size+timestamp: S3-staged inputs keep their hash

    /*
     * Retry ladder.  Exit 137 is the OOM kill Phase 2 observed at 8 GB for
     * RandomForest n_estimators>=500 on sherwood; 104/134/139/143/247 are the
     * other transient/kill codes seen on Batch.  A chunk that still fails after
     * the ladder is IGNORED, not fatal: its siblings are already published and
     * the collector records the gap, so one bad chunk cannot lose a sweep.
     */
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] && task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries    = 3

    /*
     * ---- chunk tasks -------------------------------------------------------
     * Memory is per TASK and a task runs `procs` fold-fits concurrently.  The
     * ladder climbs on retry: 8 GB covers every measured non-RNA-FM config
     * (measured p95 peak RSS 1.6 GB at S, 3.9 GB at XL), 30 GB is the whole
     * usable envelope of the pinned instance size, and the third rung takes a
     * larger instance for the one cell that is only bounded below (RF x XL was
     * OOM-killed at 8 GB, so its true requirement is unmeasured).
     *
     * NOTE the third rung (120 GB) exceeds a g4dn.2xlarge / c6id.4xlarge
     * (32 GiB), so a task that reaches it can only be placed if the compute
     * environment permits a larger size in the family.  That is deliberate --
     * the alternative is a task that can never succeed -- but it means the
     * instance-size pin below is a *preference* for attempts 1-2 and the
     * escalation may land on a bigger box.  Recorded, not hidden: every output
     * row carries the instance it actually ran on.
     */
    withLabel: chunk_cpu {
        cpus   = 8
        memory = { task.attempt == 1 ? 8.GB : (task.attempt == 2 ? 30.GB : 120.GB) }
        time   = '4h'
    }

    /*
     * GPU chunks start at 24 GB, not 12 GB.  MEASURED CORRECTION: the first rung
     * was 12 GB, derived from Phase 2's fork-based per-process RSS.  GPU chunks
     * now use the `spawn` start method (forked children cannot use CUDA -- see
     * run_chunk.py), and a spawned worker gets its OWN copy of the feature
     * matrices instead of inheriting them copy-on-write.  Measured on the smoke
     * run: chunk prim_8d24dcf3f154c775 (64 configs, procs=8, spawn) peaked at
     * 14,251.6 MB against its 12 GB request -- it succeeded only because the
     * compute environment placed it on a much larger instance than requested.
     * 24 GB covers the measured peak with headroom on a 32 GiB instance.
     *
     * Phase 4 should re-measure this: only one spawn-mode GPU chunk has been
     * observed, and per-worker copies mean GPU task RSS now scales with
     * procs x matrix size rather than being nearly flat in it.
     */
    withLabel: chunk_gpu {
        accelerator = 1
        cpus        = 8
        memory      = { task.attempt == 1 ? 24.GB : (task.attempt == 2 ? 30.GB : 120.GB) }
        time        = '4h'
    }

    // Partitioning and config splitting are pandas over a 17k-row table.
    withLabel: partition {
        cpus   = 2
        memory = 8.GB
        time   = '1h'
    }

    // Collection concatenates up to 45,950 rows x ~40 columns and joins the
    // published CSV: small, but give it room for both frames plus the join.
    withLabel: collect {
        cpus   = 4
        memory = 16.GB
        time   = '2h'
    }
}

profiles {

    /*
     * GPU arm -> batch-gpu_copy (5ZEM2WRyxXMWtRFVwpxwaz).
     *
     * NOT batch-gpu (fJ1Tu2lZEwf2cSF54nm2v): Phase 2 found it accepted three
     * runs and left all of them SUBMITTED with zero tasks for ~35 minutes,
     * while the identical launch on batch-gpu_copy started in ~5 minutes and ran
     * to completion on real T4s.  Treat batch-gpu as unhealthy.
     */
    batch_gpu {
        process.executor = 'awsbatch'
        process.queue    = 'TowerForge-5ZEM2WRyxXMWtRFVwpxwaz'
        aws.region       = 'us-west-2'
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxSpotAttempts      = 0
        wave.enabled     = true
        fusion.enabled   = true
        fusion.exportStorageCredentials = true
        docker.runOptions = '--gpus all'
    }

    // CPU arm -> bath-env-ondemand-2000cpu (6snAfKmF865VkTzUiySSin)
    batch_cpu {
        process.executor = 'awsbatch'
        process.queue    = 'TowerForge-6snAfKmF865VkTzUiySSin'
        aws.region       = 'us-west-2'
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxSpotAttempts      = 0
        wave.enabled     = true
        fusion.enabled   = true
        fusion.exportStorageCredentials = true
    }

    /*
     * Both arms in one run.  Per-label queues, so cpu chunks and gpu chunks go
     * to their own Batch environment concurrently.  This is the profile a full
     * sweep uses; the single-queue profiles above exist for isolating one arm.
     */
    batch {
        process.executor = 'awsbatch'
        aws.region       = 'us-west-2'
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxSpotAttempts      = 0
        wave.enabled     = true
        fusion.enabled   = true
        fusion.exportStorageCredentials = true
        docker.runOptions = '--gpus all'

        process {
            queue = 'TowerForge-6snAfKmF865VkTzUiySSin'
            withLabel: chunk_gpu { queue = 'TowerForge-5ZEM2WRyxXMWtRFVwpxwaz' }
            withLabel: chunk_cpu { queue = 'TowerForge-6snAfKmF865VkTzUiySSin' }
            withLabel: partition { queue = 'TowerForge-6snAfKmF865VkTzUiySSin' }
            withLabel: collect   { queue = 'TowerForge-6snAfKmF865VkTzUiySSin' }
        }
    }

    // Local execution for development and for the offline smoke test.
    local {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Local, no container: runs against an activated conda env on the host.
    local_native {
        process.executor = 'local'
        docker.enabled   = false
    }
}

/*
 * Concurrency is a PARAMETER, not a constant.  The g4dn quota
 * ("Running On-Demand G and VT instances", L-DB2E81BA, us-west-2) was NOT
 * confirmed, and 16 x g4dn.2xlarge needs 128 vCPU where this quota commonly
 * defaults to 0-64.  Start small, raise once tasks are observed starting.
 * queueSize caps how many tasks Nextflow will have in flight at once.
 */
executor {
    queueSize    = System.getenv('OLIGOGYM_QUEUE_SIZE') ? System.getenv('OLIGOGYM_QUEUE_SIZE') as Integer : 32
    submitRateLimit = '20/1min'
    exitReadTimeout = '30 min'
}

// Full provenance for every task: this is how a per-chunk cost is attributed to
// the instance that actually ran it.  Phase 2 could not attribute unit costs
// because the compute environments list families rather than sizes.
//
// NOTE these paths must NOT interpolate params.outdir/arm: config is evaluated
// before command-line params are applied, so `${params.outdir}` here resolves to
// null and the reports land in a literal "null/" directory.  They are written
// under `runinfo/` in the launch directory (Nextflow uploads them for a Seqera
// run) and the S3-published per-chunk summaries carry the same per-task facts.
timeline { enabled = true; overwrite = true; file = 'runinfo/timeline.html' }
report   { enabled = true; overwrite = true; file = 'runinfo/report.html' }
trace {
    enabled   = true
    overwrite = true
    file      = 'runinfo/trace.txt'
    fields    = 'task_id,hash,name,tag,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,cpus,memory,disk,queue,container'
}
dag { enabled = false }
